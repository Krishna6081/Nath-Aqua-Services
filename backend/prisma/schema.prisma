generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String   @unique
  password     String
  role         String   @default("CUSTOMER") // CUSTOMER | DELIVERY_PERSON | ADMIN
  profileImage String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses          Address[]
  orders             Order[]            @relation("CustomerOrders")
  assignedDeliveries Order[]            @relation("DeliveryPersonOrders")
  subscriptions      Subscription[]
  notifications      Notification[]
  deliveryAssignment DeliveryAssignment[]
}

model Product {
  id             String      @id @default(uuid())
  name           String
  description    String
  capacity       String
  price          Float
  deliveryCharge Float       @default(0)
  image          String?
  stock          Int         @default(100)
  unit           String      @default("CAN") // CAN | TANKER
  isAvailable    Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orderItems     OrderItem[]
  subscriptions  Subscription[]
  inventory      Inventory?
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String
  houseBuilding String
  street        String
  area          String
  city          String
  state         String
  pincode       String
  landmark      String?
  type          String   @default("HOME") // HOME | OFFICE | OTHER
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  subscriptions Subscription[]
}

model Order {
  id               String   @id @default(uuid())
  orderNumber      String   @unique
  userId           String
  user             User     @relation("CustomerOrders", fields: [userId], references: [id])
  addressId        String
  address          Address  @relation(fields: [addressId], references: [id])
  subtotal         Float
  deliveryCharge   Float
  discount         Float    @default(0)
  totalAmount      Float
  paymentMethod    String   @default("COD") // COD | ONLINE | UPI
  paymentStatus    String   @default("PENDING") // PENDING | SUCCESS | FAILED
  orderStatus      String   @default("PENDING") // PENDING | CONFIRMED | PREPARING | ASSIGNED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  deliveryDate     String
  deliveryTime     String
  deliveryOtp      String?
  deliveryPersonId String?
  deliveryPerson   User?    @relation("DeliveryPersonOrders", fields: [deliveryPersonId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items              OrderItem[]
  payments           Payment[]
  deliveryAssignment DeliveryAssignment[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId String?
  paymentId       String?
  signature       String?
  amount          Float
  status          String   @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeliveryAssignment {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPersonId String
  deliveryPerson   User      @relation(fields: [deliveryPersonId], references: [id])
  assignedAt       DateTime  @default(now())
  acceptedAt       DateTime?
  completedAt      DateTime?
  status           String    @default("ASSIGNED") // ASSIGNED | ACCEPTED | OUT_FOR_DELIVERY | DELIVERED | FAILED
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product   @relation(fields: [productId], references: [id])
  quantity           Int       @default(1)
  frequency          String    @default("DAILY") // DAILY | ALTERNATE_DAYS | WEEKLY | MONTHLY
  startDate          String
  endDate            String?
  deliveryTime       String    @default("08:00 AM - 10:00 AM")
  addressId          String
  address            Address   @relation(fields: [addressId], references: [id])
  status             String    @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  lastGeneratedOrder String?
  nextDeliveryDate   String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  startDate      DateTime
  endDate        DateTime
  usageLimit     Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalStock     Int      @default(100)
  availableStock Int      @default(100)
  reservedStock  Int      @default(0)
  updatedAt      DateTime @updatedAt
}
